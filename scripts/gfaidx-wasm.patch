diff -ruN a/src/fs/lazy_file.h b/src/fs/lazy_file.h
--- a/src/fs/lazy_file.h	1970-01-01 01:00:00
+++ b/src/fs/lazy_file.h	2026-11-19 20:56:01
@@ -0,0 +1,133 @@
+#ifndef GFAIDX_LAZY_FILE_H
+#define GFAIDX_LAZY_FILE_H
+
+// Graphoscope patch: a read-only file read in 4 KiB pages on demand, standing
+// in for mmap. WebAssembly (WASI) has no real mmap, and its emulation reads the
+// whole file; for a sidecar fetched by HTTP range request that would download
+// all of it. Here only the pages a query touches are read, each once. The page
+// is small because the lookups are: one 8-byte checkpoint per haplotype, each
+// in its own part of the file.
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace gfaidx {
+
+class LazyFile {
+public:
+    LazyFile() = default;
+    ~LazyFile() { close(); }
+    LazyFile(const LazyFile&) = delete;
+    LazyFile& operator=(const LazyFile&) = delete;
+
+    // Returns false when the file cannot be opened or sized.
+    bool open(const std::string& path) {
+        close();
+        fd_ = ::open(path.c_str(), O_RDONLY);
+        if (fd_ == -1) return false;
+        struct stat st {};
+        if (fstat(fd_, &st) == -1) {
+            close();
+            return false;
+        }
+        size_ = static_cast<std::uint64_t>(st.st_size);
+        return true;
+    }
+
+    void close() {
+        if (fd_ != -1) ::close(fd_);
+        fd_ = -1;
+        size_ = 0;
+        pages_.clear();
+        last_page_ = nullptr;
+    }
+
+    [[nodiscard]] bool is_open() const { return fd_ != -1; }
+    [[nodiscard]] std::uint64_t size() const { return size_; }
+
+    void read(std::uint64_t offset, void* out, std::size_t bytes) const {
+        if (offset > size_ || bytes > size_ - offset) {
+            throw std::runtime_error("Read past the end of an index file");
+        }
+        auto* dst = static_cast<unsigned char*>(out);
+        const std::lock_guard<std::mutex> lock(mutex_);
+        while (bytes > 0) {
+            const std::uint64_t index = offset / kPageSize;
+            const std::size_t within = static_cast<std::size_t>(offset % kPageSize);
+            const std::size_t take = bytes < kPageSize - within ? bytes : kPageSize - within;
+            std::memcpy(dst, page(index) + within, take);
+            dst += take;
+            offset += take;
+            bytes -= take;
+        }
+    }
+
+    template <typename T>
+    [[nodiscard]] T get(std::uint64_t offset) const {
+        T value;
+        read(offset, &value, sizeof(T));
+        return value;
+    }
+
+private:
+    static constexpr std::size_t kPageSize = 1 << 12;
+
+    const unsigned char* page(std::uint64_t index) const {
+        if (last_page_ && last_index_ == index) return last_page_;
+        auto found = pages_.find(index);
+        if (found == pages_.end()) {
+            auto buffer = std::make_unique<unsigned char[]>(kPageSize);
+            const std::uint64_t begin = index * kPageSize;
+            const std::size_t want =
+                size_ - begin < kPageSize ? static_cast<std::size_t>(size_ - begin) : kPageSize;
+            std::size_t have = 0;
+            while (have < want) {
+                const ssize_t got = ::pread(fd_, buffer.get() + have, want - have,
+                                            static_cast<off_t>(begin + have));
+                if (got <= 0) throw std::runtime_error("Failed to read an index file page");
+                have += static_cast<std::size_t>(got);
+            }
+            found = pages_.emplace(index, std::move(buffer)).first;
+        }
+        last_index_ = index;
+        last_page_ = found->second.get();
+        return last_page_;
+    }
+
+    int fd_{-1};
+    std::uint64_t size_{0};
+    mutable std::mutex mutex_;
+    mutable std::unordered_map<std::uint64_t, std::unique_ptr<unsigned char[]>> pages_;
+    mutable std::uint64_t last_index_{0};
+    mutable const unsigned char* last_page_{nullptr};
+};
+
+// Say which bytes of a file are about to be read in sequence. On a local disk
+// this is the usual readahead hint; over range requests it lets the whole run
+// be fetched at once instead of being discovered a buffer at a time.
+inline void advise_will_need(const std::string& path, std::uint64_t offset, std::uint64_t length) {
+#ifdef POSIX_FADV_WILLNEED
+    const int fd = ::open(path.c_str(), O_RDONLY);
+    if (fd == -1) return;
+    (void)posix_fadvise(fd, static_cast<off_t>(offset), static_cast<off_t>(length), POSIX_FADV_WILLNEED);
+    ::close(fd);
+#else
+    (void)path;
+    (void)offset;
+    (void)length;
+#endif
+}
+
+}  // namespace gfaidx
+
+#endif  // GFAIDX_LAZY_FILE_H
