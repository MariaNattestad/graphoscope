+    result.reference_path_runs.push_back(paths::SubpathRun{
+        candidate.path_id,
+        first_step + static_cast<std::uint64_t>(low),
+        static_cast<std::uint64_t>(high - low),
+    });
+    result.reference_run_bounds.push_back(ReferenceRunBounds{
+        starts[low],
+        high < starts.size() ? starts[high] : window_end,
+    });
+    for (std::size_t i = low; i < high; ++i) {
+        result.node_ranks.push_back(node_ranks[i]);
+    }
+    return span;
+}
