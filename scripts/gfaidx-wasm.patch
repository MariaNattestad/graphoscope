+// Graphoscope patch: find the interval from the path's coordinate checkpoints
+// (.pcx) instead of scanning the path from its first step. The checkpoints give
+// the coordinate of every Nth step, so a binary search over them brackets the
+// interval and only the steps inside the bracket are read. Upstream reads every
+// step of the path and every node length it visits: on chromosome 21 that is
+// megabytes of the index for a path nobody preselected into a .cdx. With this,
+// any path or walk is as cheap to ask a region on as a reference.
+// It selects the same steps as the scan below. A path's recorded span is not
+// re-checked against its segment lengths here, which the scan does.
+std::optional<CandidateSpan> append_overlapping_nodes_checkpointed(
+    const paths::PathIndexReader& path_index,
+    const indexer::NodeLengthIndexReader& lengths,
+    const paths::PathCoordinateCheckpointIndexReader& checkpoints,
+    const CandidatePath& candidate,
+    std::uint64_t begin,
+    std::uint64_t end,
+    PathCoordinateQueryResult& result) {
+    const auto info = path_index.get_path_info(candidate.path_id);
+    const std::uint64_t stride = checkpoints.checkpoint_stride();
+    const std::uint64_t steps = info.step_count;
+    if (steps == 0 || stride == 0) return std::nullopt;
+
+    const std::uint64_t base = candidate.coordinate_start;
+    // Checkpoint k is the coordinate at which step k * stride starts.
+    const std::uint64_t last_checkpoint = steps / stride;
+    const auto start_of = [&](std::uint64_t checkpoint) {
+        std::uint64_t at = 0;
+        return base + checkpoints.prefix_before_step(candidate.path_id, checkpoint * stride, at);
+    };
+
+    // The last checkpoint at or before `begin`.
+    std::uint64_t low_checkpoint = 0;
+    std::uint64_t high_checkpoint = last_checkpoint;
+    while (low_checkpoint < high_checkpoint) {
+        const std::uint64_t mid = low_checkpoint + (high_checkpoint - low_checkpoint + 1) / 2;
+        if (start_of(mid) <= begin) low_checkpoint = mid;
+        else high_checkpoint = mid - 1;
+    }
+    const std::uint64_t first_checkpoint = low_checkpoint;
+    // The first checkpoint at or after `end`, if the path has one.
+    low_checkpoint = first_checkpoint;
+    high_checkpoint = last_checkpoint + 1;
+    while (low_checkpoint < high_checkpoint) {
+        const std::uint64_t mid = low_checkpoint + (high_checkpoint - low_checkpoint) / 2;
+        if (start_of(mid) >= end) high_checkpoint = mid;
+        else low_checkpoint = mid + 1;
+    }
+    const std::uint64_t first_step = first_checkpoint * stride;
+    const std::uint64_t stop_step =
+        low_checkpoint <= last_checkpoint ? std::min(steps, low_checkpoint * stride) : steps;
+
+    std::vector<std::uint64_t> starts;
+    std::vector<std::uint32_t> node_ranks;
+    std::uint64_t coordinate = start_of(first_checkpoint);
+    if (stop_step > first_step) {
+        starts.reserve(static_cast<std::size_t>(stop_step - first_step));
+        node_ranks.reserve(static_cast<std::size_t>(stop_step - first_step));
+        path_index.for_each_step(info.path_id, first_step, stop_step - first_step,
+            [&](const paths::StepRecord& step, std::uint64_t) {
+                if (step.node_id >= lengths.node_count()) {
+                    throw std::runtime_error("Path references a node outside the .lnx length table: " +
