+    auto high_it = std::lower_bound(starts.begin(), starts.end(), end);
+    std::size_t high = static_cast<std::size_t>(high_it - starts.begin());
+    auto low_it = std::upper_bound(starts.begin(), starts.end(), begin);
+    std::size_t low = static_cast<std::size_t>(low_it - starts.begin());
+    if (low > 0) --low;
+    while (low < high) {
+        const auto step_end = (low + 1 < starts.size()) ? starts[low + 1] : window_end;
+        if (step_end > begin) break;
+        ++low;
+    }
+    if (low >= high) return span;
